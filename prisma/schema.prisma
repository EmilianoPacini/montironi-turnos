// Montironi Turnos - schema de postventa

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Note: exclusion constraint added in migration SQL

enum RolUsuario {
  ADMIN
  EMPLEADO
}

enum EstadoTurno {
  pendiente
  confirmado
  recibido
  en_servicio
  finalizado
  cancelado
  ausente
  vencido
}

enum OrigenTurno {
  panel
  whatsapp
  voz
  api
}

enum TipoOcupacion {
  turno
  bloqueo
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo
}

enum TipoExcepcion {
  cerrado
  horario_especial
}

model Empresa {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios             Usuario[]
  talleres             Taller[]
  tiposServicio        TipoServicio[]
  servicios            Servicio[]
  clientes             Cliente[]
  vehiculos            Vehiculo[]
  turnos               Turno[]
  configuracionTurnos  ConfiguracionTurnos?
  agentesIa            AgenteIa[]
  operacionesApi       OperacionApi[]

  @@map("empresa")
}

model Usuario {
  id           String     @id @default(cuid())
  empresaId    String     @map("empresa_id")
  email        String
  nombre       String
  passwordHash String     @map("password_hash")
  rol          RolUsuario @default(EMPLEADO)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  turnosCreados Turno[]       @relation("TurnoCreador")
  eventosTurno  EventoTurno[]

  @@unique([empresaId, email])
  @@map("usuario")
}

model Taller {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nombre    String
  direccion String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  bahias           Bahia[]
  tallerServicios  TallerServicio[]
  patronesHorario  PatronHorario[]
  excepciones      ExcepcionHorario[]
  turnos           Turno[]

  @@map("taller")
}

model Bahia {
  id        String   @id @default(cuid())
  tallerId  String   @map("taller_id")
  nombre    String
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  taller          Taller           @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  bahiaServicios  BahiaServicio[]
  ocupaciones     OcupacionBahia[]
  turnos          Turno[]

  @@map("bahia")
}

model TipoServicio {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  servicios Servicio[]

  @@map("tipo_servicio")
}

model Servicio {
  id             String   @id @default(cuid())
  empresaId      String   @map("empresa_id")
  tipoServicioId String   @map("tipo_servicio_id")
  nombre         String
  descripcion    String?
  duracionMin    Int      @map("duracion_min")
  precio         Decimal  @db.Decimal(10, 2)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoServicio    TipoServicio     @relation(fields: [tipoServicioId], references: [id])
  tallerServicios TallerServicio[]
  bahiaServicios  BahiaServicio[]
  detallesTurno   DetalleTurno[]

  @@map("servicio")
}

model TallerServicio {
  id         String  @id @default(cuid())
  tallerId   String  @map("taller_id")
  servicioId String  @map("servicio_id")
  activo     Boolean @default(true)

  taller   Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  servicio Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@unique([tallerId, servicioId])
  @@map("taller_servicio")
}

model BahiaServicio {
  id         String  @id @default(cuid())
  bahiaId    String  @map("bahia_id")
  servicioId String  @map("servicio_id")
  activo     Boolean @default(true)

  bahia    Bahia    @relation(fields: [bahiaId], references: [id], onDelete: Cascade)
  servicio Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@unique([bahiaId, servicioId])
  @@map("bahia_servicio")
}

model PatronHorario {
  id       String    @id @default(cuid())
  tallerId String    @map("taller_id")
  dia      DiaSemana
  activo   Boolean   @default(true)

  taller   Taller           @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  franjas  FranjaHoraria[]

  @@unique([tallerId, dia])
  @@map("patron_horario")
}

model FranjaHoraria {
  id              String @id @default(cuid())
  patronHorarioId String @map("patron_horario_id")
  horaInicio      String @map("hora_inicio")
  horaFin         String @map("hora_fin")

  patronHorario PatronHorario @relation(fields: [patronHorarioId], references: [id], onDelete: Cascade)

  @@map("franja_horaria")
}

model ExcepcionHorario {
  id         String        @id @default(cuid())
  tallerId   String        @map("taller_id")
  fecha      DateTime      @db.Date
  tipo       TipoExcepcion
  horaInicio String?       @map("hora_inicio")
  horaFin    String?       @map("hora_fin")
  motivo     String?

  taller Taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@unique([tallerId, fecha])
  @@map("excepcion_horario")
}

model ConfiguracionTurnos {
  id        String @id @default(cuid())
  empresaId String @unique @map("empresa_id")
  margenMin Int    @default(15) @map("margen_min")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracion_turnos")
}

model Cliente {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nombre    String
  apellido  String?
  email     String?
  telefono  String?
  documento String?
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa    Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vehiculos  ClienteVehiculo[]
  documentos DocumentoCliente[]
  turnos     Turno[]

  @@map("cliente")
}

model Vehiculo {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  patente   String
  marca     String?
  modelo    String?
  anio      Int?
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa  Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clientes ClienteVehiculo[]
  turnos   Turno[]

  @@unique([empresaId, patente])
  @@map("vehiculo")
}

model ClienteVehiculo {
  id        String @id @default(cuid())
  clienteId String @map("cliente_id")
  vehiculoId String @map("vehiculo_id")
  esPrincipal Boolean @default(false) @map("es_principal")

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, vehiculoId])
  @@map("cliente_vehiculo")
}

model DocumentoCliente {
  id        String   @id @default(cuid())
  clienteId String   @map("cliente_id")
  nombre    String
  url       String?
  tipo      String?
  createdAt DateTime @default(now()) @map("created_at")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("documento_cliente")
}

model Turno {
  id          String      @id @default(cuid())
  empresaId   String      @map("empresa_id")
  tallerId    String      @map("taller_id")
  bahiaId     String      @map("bahia_id")
  clienteId   String      @map("cliente_id")
  vehiculoId  String      @map("vehiculo_id")
  creadorId   String?     @map("creador_id")
  agenteIaId  String?     @map("agente_ia_id")
  estado      EstadoTurno @default(pendiente)
  origen      OrigenTurno @default(panel)
  inicio      DateTime
  fin         DateTime
  notas       String?
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  empresa     Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  taller      Taller           @relation(fields: [tallerId], references: [id])
  bahia       Bahia            @relation(fields: [bahiaId], references: [id])
  cliente     Cliente          @relation(fields: [clienteId], references: [id])
  vehiculo    Vehiculo         @relation(fields: [vehiculoId], references: [id])
  creador     Usuario?         @relation("TurnoCreador", fields: [creadorId], references: [id])
  agenteIa    AgenteIa?        @relation(fields: [agenteIaId], references: [id])
  detalles    DetalleTurno[]
  ocupacion   OcupacionBahia?
  eventos     EventoTurno[]

  @@index([empresaId, inicio])
  @@index([bahiaId, inicio])
  @@map("turno")
}

model DetalleTurno {
  id            String  @id @default(cuid())
  turnoId       String  @map("turno_id")
  servicioId    String  @map("servicio_id")
  nombreSnapshot String @map("nombre_snapshot")
  duracionMin   Int     @map("duracion_min")
  precioSnapshot Decimal @map("precio_snapshot") @db.Decimal(10, 2)
  orden         Int     @default(0)

  turno    Turno    @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@map("detalle_turno")
}

model OcupacionBahia {
  id        String        @id @default(cuid())
  bahiaId   String        @map("bahia_id")
  turnoId   String?       @unique @map("turno_id")
  tipo      TipoOcupacion
  inicio    DateTime
  fin       DateTime
  activo    Boolean       @default(true)
  motivo    String?
  createdAt DateTime      @default(now()) @map("created_at")

  bahia Bahia  @relation(fields: [bahiaId], references: [id], onDelete: Cascade)
  turno Turno? @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@index([bahiaId, inicio, fin])
  @@map("ocupacion_bahia")
}

model EventoTurno {
  id          String       @id @default(cuid())
  turnoId     String       @map("turno_id")
  usuarioId   String?      @map("usuario_id")
  agenteIaId  String?      @map("agente_ia_id")
  estadoPrev  EstadoTurno? @map("estado_prev")
  estadoNuevo EstadoTurno  @map("estado_nuevo")
  detalle     String?
  createdAt   DateTime     @default(now()) @map("created_at")

  turno    Turno     @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  usuario  Usuario?  @relation(fields: [usuarioId], references: [id])
  agenteIa AgenteIa? @relation(fields: [agenteIaId], references: [id])

  @@map("evento_turno")
}

model OperacionApi {
  id                 String   @id @default(cuid())
  empresaId          String   @map("empresa_id")
  claveIdempotencia  String   @map("clave_idempotencia")
  huellaSolicitud    String   @map("huella_solicitud")
  operacion          String
  respuesta          Json
  createdAt          DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, claveIdempotencia])
  @@map("operacion_api")
}

model AgenteIa {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  turnos       Turno[]
  eventosTurno EventoTurno[]

  @@map("agente_ia")
}
