services:
  postgres:
    image: postgres:16-alpine
    container_name: montironi-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: montironi
      POSTGRES_PASSWORD: montironi
      POSTGRES_DB: montironi_turnos
    ports:
      - "5433:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U montironi -d montironi_turnos"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:
