# App en el host (`npm run dev`): localhost + puerto de tu Postgres.
DATABASE_URL="postgresql://montironi:montironi@localhost:5432/montironi_turnos?schema=public"
# App en Docker: si Postgres corre en la misma máquina, no uses localhost.
# host.docker.internal apunta al host desde el contenedor.
DOCKER_DATABASE_URL="postgresql://montironi:montironi@host.docker.internal:5432/montironi_turnos?schema=public"
SESSION_SECRET="change-me-to-a-random-string-at-least-32-characters"
# En Docker local (HTTP) debe ser false. En HTTPS de producción, true.
SESSION_COOKIE_SECURE="false"
AGENT_API_KEY="your-agent-api-key"
AGENT_API_EMPRESA="montironi"
NEXT_PUBLIC_APP_NAME="Cima AI"
# Opcional: clave estable para Server Actions entre reinicios de `next dev`
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="pegá-acá-salida-de-openssl-rand-base64-32"
# Seed automático al levantar el contenedor si la DB está vacía
AUTO_SEED="true"

# Comunicaciones (WAH)
CIMA_FORWARD_SECRET="change-me-cima-forward-secret"
META_WHATSAPP_ACCESS_TOKEN=""
WAH_MESSAGE_WEBHOOK_URL=""
WAH_MEDIA_DIR="./data/wah-media"
WAH_SEND_FILES_DIR="./data/wah-send"
